<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the macOS app's Info.plist by Tauri. -->
<plist version="1.0">
<dict>
	<!-- Only standard encryption (HTTPS through the system and rustls), so
	     App Store Connect needs no export compliance documents. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Rupert's languages, so macOS shows its own panels (open, save,
	     share) in them, and offers the per-app language setting. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
	</array>
</dict>
</plist>
