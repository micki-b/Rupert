<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store edition runs in the App Sandbox (tauri.appstore.conf.json).
     scripts/build-app-store.sh adds the application and team identifiers for
     submission builds, which also embed the provisioning profile. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The folders the user picks (sources, the inbox, ScanSnap Home's library) -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Keeping access to them across launches (security-scoped bookmarks) -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Local AI (LM Studio, Ollama, …), cloud models, network scanners, OneDrive/ChatGPT sign-in -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Scanner discovery (Bonjour multicast) and the ChatGPT sign-in's one-time local listener -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
