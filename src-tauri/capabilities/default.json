{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and Settings windows (links in Markdown open in the browser)",
  "windows": [
    "main",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-save",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "updater:default",
    "process:allow-restart"
  ]
}
