{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rupert",
  "mainBinaryName": "rupert",
  "version": "0.4.0",
  "identifier": "io.github.micki-b.rupert",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Rupert",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "pdfium/**/*": "pdfium/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSE": "LICENSE"
    },
    "publisher": "Micki Braun",
    "copyright": "© 2026 Micki Braun. MIT license.",
    "homepage": "https://github.com/micki-b/Rupert",
    "category": "Productivity",
    "shortDescription": "The librarian for your scanned documents",
    "longDescription": "Rupert finds, files and searches your scanned documents and PDFs right where they are: in folders on your computer, iCloud Drive or OneDrive. Titles, tags and dates are stored inside the files.",
    "license": "MIT",
    "windows": {
      "nsis": {
        "languages": ["English", "Spanish", "German"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwREM5QzhGQzcwOUYxMzMKUldRejhRbkhqNXpjd0ZYSDdaVmNwYUdGc2x1NmM0VTUwcnhrRDhLYUtYVlRIQ053Yk1VWU1RVkMK",
      "endpoints": [
        "https://github.com/micki-b/Rupert/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
