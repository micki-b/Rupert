# rupertlibrarian.com: Apache settings for Bluehost shared hosting. This
# folder sits inside the main site's public_html, whose WordPress rules would
# otherwise apply here too; turning the rewrite engine on below replaces them.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # One address: rupertlibrarian.com without www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [L,R=301]
  # Once Bluehost's SSL certificate for the domain is active, send everyone
  # to https (uncomment):
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://rupertlibrarian.com%{REQUEST_URI} [L,R=301]
</IfModule>
