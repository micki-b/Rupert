<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The scan link from the desktop app's QR code (#124); the site serves
	     /.well-known/apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:rupertlibrarian.com</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.micki-b.rupert</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)io.github.micki-b.rupert</string>
	</array>
</dict>
</plist>
