{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rupert",
  "version": "0.1.0",
  "identifier": "io.github.micki-b.rupert",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": ".." },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build", "cwd": ".." },
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rupert",
        "url": "phone"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "iOS": {
      "developmentTeam": "9FP28N8GW3",
      "minimumSystemVersion": "16.0"
    }
  }
}
