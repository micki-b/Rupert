{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rupert",
  "version": "0.2.0",
  "identifier": "io.github.micki-b.rupert",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": ".."
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": ".."
    },
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rupert",
        "url": "phone"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "iOS": {
      "developmentTeam": "9FP28N8GW3",
      "minimumSystemVersion": "16.0"
    },
    "publisher": "Micki Braun",
    "copyright": "© 2026 Micki Braun. MIT license.",
    "homepage": "https://github.com/micki-b/Rupert",
    "category": "Productivity",
    "shortDescription": "The librarian for your scanned documents",
    "longDescription": "Rupert finds, files and searches your scanned documents and PDFs right where they are: in folders on your computer, iCloud Drive or OneDrive. Titles, tags and dates are stored inside the files.",
    "license": "MIT",
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSE": "LICENSE"
    }
  }
}
