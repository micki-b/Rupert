<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Rupert uses the camera to scan paper documents into your inbox.</string>
	<key>UIFileSharingEnabled</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- rupert://scan opens the Scan tab: the scan link's web page offers it
	     when the link opened in the browser (#124). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.micki-b.rupert.scan</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>rupert</string>
			</array>
		</dict>
	</array>
	<!-- Only standard encryption (HTTPS): answers App Store export compliance. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
